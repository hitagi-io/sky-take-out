.page {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
}

.user-card {
  background: linear-gradient(145deg, #eff6ff, #ffffff);
  border: 1rpx solid #dbeafe;
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.08);
}

.avatar-static {
  flex-shrink: 0;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 4rpx solid #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.1);
}

/* 微信默认的灰色占位头像 */
.avatar-default {
  position: relative;
  overflow: hidden;
  background: #e5e7eb;
}

.avatar-head {
  position: absolute;
  top: 22rpx;
  left: 50%;
  width: 36rpx;
  height: 36rpx;
  margin-left: -18rpx;
  border-radius: 50%;
  background: #9ca3af;
}

.avatar-body {
  position: absolute;
  bottom: 14rpx;
  left: 50%;
  width: 64rpx;
  height: 32rpx;
  margin-left: -32rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #9ca3af;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nick-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nick-default {
  color: #9ca3af;
}

.user-sub {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

/* 我的订单 */
.order-card {
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.section-more {
  font-size: 26rpx;
  color: #6b7280;
}

.order-grid {
  display: flex;
  margin-top: 20rpx;
}

.order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 16rpx;
}

.order-item:active {
  background: #eff6ff;
}

.order-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d4ed8;
  line-height: 1;
}

.order-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4b5563;
}

/* 功能入口 */
.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 8rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
}

.menu-arrow {
  color: #9ca3af;
  font-size: 36rpx;
}

/* 退出登录 */
.logout-card {
  margin-top: 24rpx;
  padding: 30rpx;
  text-align: center;
  color: #ef4444;
  font-size: 28rpx;
  font-weight: 500;
}
