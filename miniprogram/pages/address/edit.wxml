<view class="page">
  <view class="card form">
    <view class="form-row">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="姓名" placeholder-class="ph" value="{{consignee}}" data-field="consignee" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">性别</text>
      <view class="sex-opts">
        <view class="sex {{sex === '1' ? 'on' : ''}}" data-value="1" bindtap="onSex">先生</view>
        <view class="sex {{sex === '0' ? 'on' : ''}}" data-value="0" bindtap="onSex">女士</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="11位手机号" placeholder-class="ph" value="{{phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegion">
        <view class="form-picker {{region.length ? '' : 'ph'}}">
          {{region.length ? region[0] + ' ' + region[1] + ' ' + region[2] : '省 / 市 / 区'}}
        </view>
      </picker>
    </view>
    <view class="form-row column">
      <text class="form-label">详细地址</text>
      <textarea class="form-textarea" placeholder="小区、楼栋、门牌号等" placeholder-class="ph" value="{{detail}}" data-field="detail" bindinput="onInput" maxlength="100" auto-height />
    </view>
    <view class="form-row">
      <text class="form-label">标签</text>
      <view class="sex-opts">
        <view
          wx:for="{{labels}}"
          wx:key="*this"
          class="sex {{label === item ? 'on' : ''}}"
          data-value="{{item}}"
          bindtap="onLabel"
        >{{item}}</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{isDefault}}" color="#2563eb" bindchange="onDefault" />
    </view>
  </view>

  <view class="footer">
    <view class="btn-primary save-btn {{saving ? 'disabled' : ''}}" bindtap="onSave">{{saving ? '保存中...' : '保存'}}</view>
  </view>
</view>
