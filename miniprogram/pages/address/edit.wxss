.page {
  padding: 24rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row.column {
  flex-direction: column;
  align-items: stretch;
}

.form-label {
  color: #111827;
  font-weight: 500;
  width: 160rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}

.form-picker {
  color: #111827;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  margin-top: 16rpx;
  min-height: 120rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.ph {
  color: #9ca3af;
}

.sex-opts {
  display: flex;
  gap: 16rpx;
}

.sex {
  padding: 8rpx 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e7eb;
  font-size: 26rpx;
  background: #ffffff;
  color: #6b7280;
}

.sex.on {
  background: #eff6ff;
  color: #1d4ed8;
  border-color: #dbeafe;
  font-weight: 500;
}

.footer {
  margin-top: auto;
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
}

.save-btn {
  width: 100%;
}
