.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.tabs {
  background: #ffffff;
  white-space: nowrap;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.tab {
  display: inline-block;
  padding: 8rpx 26rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6b7280;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
}

.tab.active {
  background: #eff6ff;
  border-color: #dbeafe;
  color: #1d4ed8;
  font-weight: 600;
}

.list {
  flex: 1;
  padding: 24rpx;
}

.order-card {
  margin-bottom: 24rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.order-shop {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.order-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.order-dishes {
  font-size: 26rpx;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid transparent;
}

.order-status.s1 {
  color: #b45309;
  background: #fffbeb;
  border-color: #fde68a;
}
.order-status.s2,
.order-status.s3,
.order-status.s4 {
  color: #1d4ed8;
  background: #eff6ff;
  border-color: #dbeafe;
}
.order-status.s5 {
  color: #047857;
  background: #ecfdf5;
  border-color: #a7f3d0;
}
.order-status.s6 {
  color: #6b7280;
  background: #f3f4f6;
  border-color: #e5e7eb;
}

.order-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.btn-mini-primary {
  background: #2563eb;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  padding: 12rpx 32rpx;
}

.empty-btn {
  margin-top: 32rpx;
  width: 240rpx;
}

.list-end {
  text-align: center;
  padding: 30rpx 0 calc(30rpx + env(safe-area-inset-bottom));
  font-size: 26rpx;
}

.list-loading {
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
}
