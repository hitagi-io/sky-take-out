.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.content {
  flex: 1;
  padding: 24rpx;
}

.card {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* 地址 */
.addr-card {
  position: relative;
  padding-right: 60rpx;
}

.addr-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 10rpx;
}

.addr-name {
  font-size: 32rpx;
  font-weight: 600;
}

.addr-phone {
  color: #6b7280;
}

.addr-detail {
  font-size: 26rpx;
}

.addr-empty {
  color: #2563eb;
  font-size: 30rpx;
}

.addr-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #9ca3af;
  font-size: 44rpx;
}

/* 商品 */
.goods-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.goods-img {
  width: 90rpx;
  height: 90rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
}

.goods-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  color: #111827;
}

.goods-flavor {
  font-size: 24rpx;
}

.goods-price {
  margin-left: 24rpx;
  width: 130rpx;
  text-align: right;
}

/* 行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.row-label {
  color: #111827;
  font-weight: 500;
}

.row-opts {
  display: flex;
  gap: 16rpx;
}

.opt {
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e7eb;
  font-size: 26rpx;
  background: #ffffff;
  color: #6b7280;
}

.opt.on {
  background: #eff6ff;
  color: #1d4ed8;
  border-color: #dbeafe;
  font-weight: 500;
}

.picker-val {
  color: #1d4ed8;
}

.remark-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
}

.ph {
  color: #9ca3af;
}

/* 底部 */
.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5e7eb;
}

.footer-label {
  color: #4b5563;
  font-size: 26rpx;
  margin-right: 12rpx;
}

.footer-price {
  font-size: 44rpx;
}

.submit-btn {
  width: 260rpx;
}

/* 支付弹窗 */
.pay-popup {
  align-items: center;
  text-align: center;
}

.pay-amount {
  font-size: 64rpx;
  font-weight: 600;
  color: #111827;
  margin: 16rpx 0 8rpx;
}

.pay-no {
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.pay-method {
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 28rpx 8rpx;
  border-top: 1rpx solid #f3f4f6;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 30rpx;
}

.pay-check {
  color: #2563eb;
  font-weight: 600;
}

.pay-btn {
  width: 100%;
  margin-top: 32rpx;
}

.pay-cancel {
  margin-top: 24rpx;
  color: #9ca3af;
  font-size: 26rpx;
  padding-bottom: 20rpx;
}
