<view class="page">
  <view class="orb orb-1"></view>
  <view class="orb orb-2"></view>
  <view class="card login-card">
    <view class="title">天空外卖</view>

    <view class="btn-primary auth-btn {{loading ? 'disabled' : ''}}" bindtap="onAuthLogin">
      {{loading ? '登录中...' : '微信授权登录'}}
    </view>
    <view class="cancel" bindtap="onCancel">暂不登录，随便逛逛</view>
  </view>
</view>
