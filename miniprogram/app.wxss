/* 全局样式：对齐商家端设计语言（主色 #2563eb / 灰底 #f3f4f6 / 白色圆角卡片 / 细边框 + 柔和阴影） */
page {
  background: #f3f4f6;
  color: #111827;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, image, button, input, textarea, picker, scroll-view, swiper {
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.08);
  border: 1rpx solid #e5e7eb;
}

.btn-primary {
  background: #2563eb;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  padding: 22rpx 0;
}

.btn-primary.disabled {
  background: #a5c4f5;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #4b5563;
  border: 2rpx solid #d1d5db;
  border-radius: 16rpx;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
}

.text-muted {
  color: #9ca3af;
}

.text-sub {
  color: #6b7280;
}

.price {
  color: #2563eb;
  font-weight: 600;
}

.price::first-letter {
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #eff6ff;
  border: 1rpx solid #dbeafe;
  color: #1d4ed8;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #9ca3af;
}

/* 遮罩弹层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.5);
  z-index: 100;
  animation: mask-in 0.2s ease-out;
}

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  animation: popup-up 0.22s ease-out;
}

.popup-title {
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding-bottom: 24rpx;
}

@keyframes popup-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 高层级弹层：用于需要盖住底部购物车栏(z-index:102)的弹窗 */
.mask.high {
  z-index: 103;
}

.popup.high {
  z-index: 104;
}
